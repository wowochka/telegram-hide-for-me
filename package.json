{
  "name": "telegram-hide-for-me",
  "private": true,
  "version": "0.1.0",
  "description": "Hide for Me: hide one person's messages in a Telegram group, only for yourself. A feature proposal with a working iOS-style prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "fetch-pattern": "node scripts/fetch-pattern.mjs",
    "render": "vite build && node video/render-source/render.mjs && node video/render-source/sound.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
